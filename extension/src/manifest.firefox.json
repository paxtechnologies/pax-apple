{
  "manifest_version": 3,
  "name": "Pax Image Blur",
  "version": "0.6.0",
  "description": "Blurs unwanted pictures and video on any web page, checked on this device. Part of Pax Peace (paxpeace.com).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "dns"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "Pax Image Blur",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": [
      "vendor/pax-ml.min.js",
      "core.js",
      "classifier.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pax-image-blur@paxmobile.org",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
